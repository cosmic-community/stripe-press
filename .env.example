# Cosmic API credentials (server-side)
COSMIC_BUCKET_SLUG=your-bucket-slug
NEXT_PUBLIC_COSMIC_BUCKET_SLUG=your-bucket-slug
COSMIC_READ_KEY=your-read-key
# Needed for customer accounts, carts, orders and the OAuth device flow
COSMIC_WRITE_KEY=your-write-key

# Signs session cookies and agent access tokens. Use a long random string.
# Falls back to COSMIC_WRITE_KEY if unset.
AUTH_SECRET=

# Optional: force the public origin used in OAuth metadata and Stripe redirects
# SITE_URL=https://stripe-press.cosmic.site

# Hosted Cosmic CAP door that answers questions (defaults to this project's door)
# CAP_UPSTREAM_URL=https://dapi.cosmicjs.com/cap/v1/ck_2e04b1b4bd442d6998d3586711375b01

# Stripe (test mode). Checkout shows "not configured" until these are set.
STRIPE_SECRET_KEY=
# Webhook endpoint: https://stripe-press.cosmic.site/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired,
#         checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# Cosmic Insights
COSMIC_INSIGHTS_PROJECT=6afdf26a48f83858e228fb10
NEXT_PUBLIC_COSMIC_INSIGHTS_PROJECT=6afdf26a48f83858e228fb10
